{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**,chatbot/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py?path=$1" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" }
  ]
}
